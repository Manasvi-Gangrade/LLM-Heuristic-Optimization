    "best_code": "def heuristic(problem_instance):\n    n = problem_instance[\"n_cities\"]\n    dist = problem_instance[\"dist_matrix\"]\n    tour = [0]\n    unvisited = set(range(1, n))\n    while unvisited:\n        current = tour[-1]\n        next_city = min(unvisited, key=lambda c: dist[current][c])\n        tour.append(next_city)\n        unvisited.remove(next_city)\n    cost = sum(dist[tour[i]][tour[i+1]] for i in range(n-1)) + dist[tour[-1]][tour[0]]\n    for _ in range(10):  # reduced number of iterations\n        improved = False\n        for i in range(len(tour) - 1):\n            for j in range(i + 1, len(tour)):\n                new_tour = tour[:i] + list(reversed(tour[i:j])) + tour[j:]\n                new_cost = sum(dist[new_tour[k]][new_tour[k+1]] for k in range(len(new_tour) - 1)) + dist[new_tour[-1]][new_tour[0]]\n                if new_cost < cost:\n                    tour = new_tour\n                    cost = new_cost\n                    improved = True\n        if not improved:\n            break\n    return {\"tour\": tour, \"cost\": cost}",
