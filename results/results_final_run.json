    "best_code": "def heuristic(problem_instance):\n    import numpy as np\n    n = problem_instance[\"n_cities\"]\n    dist = problem_instance[\"dist_matrix\"]\n    tour = [0]\n    unvisited = set(range(1, n))\n    for _ in range(n-1):\n        current = tour[-1]\n        nearest = min(unvisited, key=lambda c: dist[current][c])\n        tour.append(nearest)\n        unvisited.remove(nearest)\n    cost = sum(dist[tour[i]][tour[i+1]] for i in range(n-1)) + dist[tour[-1]][tour[0]]\n\n    best_cost = cost\n    best_tour = tour.copy()\n\n    for i in range(1, n - 1):\n        for j in range(i + 1, n):\n            new_tour = tour[:i] + list(reversed(tour[i:j])) + tour[j:]\n            new_cost = sum(dist[new_tour[k]][new_tour[k+1]] for k in range(n-1)) + dist[new_tour[-1]][new_tour[0]]\n            if new_cost < best_cost:\n                best_cost = new_cost\n                best_tour = new_tour\n\n    return {\"tour\": best_tour, \"cost\": best_cost}",
