    "best_code": "import numpy as np\nimport random\n\ndef heuristic(problem_instance):\n    n = problem_instance[\"n_cities\"]\n    dist = problem_instance[\"dist_matrix\"]\n    tour = list(range(n))\n    random.shuffle(tour)\n    for _ in range(n // 2):\n        improved = False\n        for i in range(n):\n            for j in range(i + 1, n):\n                new_tour = tour[:i] + list(reversed(tour[i:j])) + tour[j:]\n                new_cost = sum(dist[new_tour[k]][new_tour[k+1]] for k in range(n-1)) + dist[new_tour[-1]][new_tour[0]]\n                old_cost = sum(dist[tour[k]][tour[k+1]] for k in range(n-1)) + dist[tour[-1]][tour[0]]\n                if new_cost < old_cost:\n                    tour = new_tour\n                    improved = True\n        if not improved:\n            break\n    for i in range(n):\n        for j in range(i + 1, n):\n            new_tour = tour[:i] + list(reversed(tour[i:j])) + tour[j:]\n            new_cost = sum(dist[new_tour[k]][new_tour[k+1]] for k in range(n-1)) + dist[new_tour[-1]][new_tour[0]]\n            old_cost = sum(dist[tour[k]][tour[k+1]] for k in range(n-1)) + dist[tour[-1]][tour[0]]\n            if new_cost < old_cost:\n                tour = new_tour\n    cost = sum(dist[tour[i]][tour[i+1]] for i in range(n-1)) + dist[tour[-1]][tour[0]]\n    return {\"tour\": tour, \"cost\": cost}",
