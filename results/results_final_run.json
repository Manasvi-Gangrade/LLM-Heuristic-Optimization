    "best_code": "import random\n\ndef heuristic(problem_instance):\n    n = problem_instance[\"n_cities\"]\n    dist = problem_instance[\"dist_matrix\"]\n    if n <= 1:\n        return {\"tour\": list(range(n)), \"cost\": 0.0}\n    samples = max(10, n // 5)\n    best_tour = None\n    best_cost = float('inf')\n    base = list(range(n))\n    for _ in range(samples):\n        tour = base[:]\n        random.shuffle(tour)\n        improved = True\n        while improved:\n            improved = False\n            for i in range(1, n - 1):\n                a = tour[i - 1]\n                b = tour[i]\n                for k in range(i + 1, n):\n                    c = tour[k]\n                    d = tour[(k + 1) % n]\n                    delta = dist[a][c] + dist[b][d] - dist[a][b] - dist[c][d]\n                    if delta < -1e-12:\n                        tour[i:k + 1] = reversed(tour[i:k + 1])\n                        improved = True\n        cost = sum(dist[tour[i]][tour[(i + 1) % n]] for i in range(n))\n        if cost < best_cost:\n            best_cost = cost\n            best_tour = tour[:]\n    if best_tour is None:\n        tour = [0]\n        unvisited = set(range(1, n))\n        while unvisited:\n            cur = tour[-1]\n            nxt = min(unvisited, key=lambda c: dist[cur][c])\n            tour.append(nxt)\n            unvisited.remove(nxt)\n        best_tour = tour\n        best_cost = sum(dist[tour[i]][tour[(i + 1) % n]] for i in range(n))\n    return {\"tour\": best_tour, \"cost\": float(best_cost)}",
